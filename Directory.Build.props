<Project>
    <PropertyGroup>
		<Version>5.1.5</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	
	<ItemGroup Condition="'$(IsPackable)' == 'true'">
		<None Include="$(MSBuildThisFileDirectory)README.md"
			  Pack="true"
			  PackagePath="\"
			  Visible="false" />
	</ItemGroup>
</Project>